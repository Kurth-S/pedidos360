# Copia este archivo como .env (el .env NO se sube a GitHub) y completa los valores.

# --- RabbitMQ (docker-compose.yml) ---
RABBITMQ_ERLANG_COOKIE=cambia-esta-cookie
RABBIT_USER=admin
RABBIT_PASS=cambia-esta-clave

# --- Kafka (docker-compose.kafka.yml / docker-compose.kafka-ui.yml) ---
# IP o DNS con el que los microservicios llegan a los brokers. Mismo host: localhost.
KAFKA_EXTERNAL_HOST=localhost
KAFKA_UI_USER=admin
KAFKA_UI_PASSWORD=cambia-esta-clave
